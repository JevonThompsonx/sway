{
    "height": 30,
    "modules-left": [
        "sway/workspaces"
    ],
    "modules-center": [
        "sway/window"
    ],
    "modules-right": [
        "custom/network",
        "bluetooth",
        "clock",
        "cpu",
        "memory",
        "battery"
    ],
    "tray": {
        "icon-size": 16,
        "spacing": 10
    },
    "custom/network": {
        "exec": "~/.config/waybar/scripts/network.sh",
        "return-type": "json",
        "format": "{}",
        "on-click": "nm-connection-editor",
        "interval": 5,
        "tooltip": true
    },
    "bluetooth": {
        "format-on": " ",
        "format-off": " ",
        "format-connected": " {num_connections}",
        "tooltip-format": "{device_alias}\n{device_address}",
        "on-click": "gnome-control-center bluetooth",
        "interval": 5
    },
    "clock": {
        "format": "{:%Y-%m-%d %H:%M:%S}"
    },
    "cpu": {
        "format": "CPU: {usage}%"
    },
    "memory": {
        "format": "RAM: {used}GB"
    },
    "battery": {
        "format": "BAT: {capacity}%"
    }
}
